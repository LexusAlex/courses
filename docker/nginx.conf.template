server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # This is a static multi-page site: missing URLs must remain real 404s.
    location / {
        try_files $uri $uri/ =404;
    }

    location ~* /_astro/.*\.(?:css|js|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    error_page 404 ${SITE_BASE}404.html;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
